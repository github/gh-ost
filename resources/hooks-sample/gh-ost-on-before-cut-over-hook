#!/bin/bash

# Sample hook file for gh-ost-on-before-cut-over

message="$GH_OST_DATABASE_NAME.$GH_OST_TABLE_NAME"
if [ "$GH_OST_MOVE_TABLES" = "true" ]; then
  message="$GH_OST_DATABASE_NAME ($GH_OST_TABLES) -> $GH_OST_TARGET_HOST/$GH_OST_TARGET_DATABASE_NAME"
fi

echo "$(date) gh-ost-on-before-cut-over $message" >> /tmp/gh-ost.log
